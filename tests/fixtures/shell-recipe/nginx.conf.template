# Wizard shell (wizard-ux): serves the phone/desktop UX and passes every API path to the Wizard Agent Service.
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  types { application/manifest+json webmanifest; text/markdown md; }
  default_type application/octet-stream;
  access_log /dev/stdout;
  server_tokens off;
  # Relative redirects: the shell sits behind HTTPS proxies that it cannot see.
  absolute_redirect off;
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  # Voice notes and attachments go to the service; it enforces its own limits.
  client_max_body_size 110m;
  map $http_upgrade $connection_upgrade { default upgrade; '' ''; }
  # The agent's `wizard` MCP gateway is box-only. Alongside mode keeps the agent's entry on the shell's loopback
  # port, so the shell passes it on only for a direct loopback caller that carries no proxy marks; anything else
  # (a tailnet or reverse-proxy request, another container) is refused here, and again by the service.
  map "$remote_addr|$http_x_forwarded_for$http_forwarded$http_x_real_ip$http_tailscale_user_login$http_cf_connecting_ip$http_cf_access_jwt_assertion" $wizard_mcp_local {
    "127.0.0.1|" 1;
    default 0;
  }
  # Re-resolve the service name so the Agent Service can be replaced without restarting the shell.
  resolver 127.0.0.11 valid=5s ipv6=off;
  server {
    listen ${WIZARD_SHELL_LISTEN};
    server_name _;
    set $wizard_api "${WIZARD_AGENT_SERVICE_ORIGIN}";

    location = /shell-health { default_type application/json; return 200 '{"ok":true,"component":"wizard-shell"}'; }
    location = / { return 302 /wizard-os-home/$is_args$args; }
    location = /wizard-os-home { return 302 /wizard-os-home/$is_args$args; }
    location = /wizard-ux { return 302 /wizard-os-home/$is_args$args; }
    # Thread links (/wizard/?session=...) open the same shell, as the bundled image served them.
    location = /wizard { return 302 /wizard-os-home/$is_args$args; }
    location = /wizard/ { return 302 /wizard-os-home/$is_args$args; }

    location ^~ /wizard/mcp {
      if ($wizard_mcp_local = 0) { return 403 '{"error":"box_only"}'; }
      proxy_pass $wizard_api$request_uri; include /tmp/wizard-proxy-mcp.conf;
    }

    # The shell's own API paths (native multipart voice, orb router) belong to the service; ^~ so no static or
    # dotfile rule can shadow them. /wizard-ux/ is the bundled image's prefix: same API, rewritten raw.
    location ^~ /wizard-os-home/api/ { proxy_pass $wizard_api$request_uri; include /tmp/wizard-proxy.conf; }
    location ^~ /wizard-ux/api/ {
      rewrite ^/wizard-ux/api/(.*)$ /wizard-os-home/api/$1 break;
      proxy_pass $wizard_api; include /tmp/wizard-proxy.conf;
    }

    # Static UX (both prefixes). Each prefix's service worker may control its own prefix.
    location = /wizard-os-home/sw.js {
      root /usr/share/nginx/wizard-ux; try_files /sw.js =404;
      add_header Service-Worker-Allowed /wizard-os-home/ always;
      include /tmp/wizard-static.conf;
    }
    location = /wizard-ux/sw.js {
      root /usr/share/nginx/wizard-ux; try_files /sw.js =404;
      add_header Service-Worker-Allowed /wizard-ux/ always;
      include /tmp/wizard-static.conf;
    }
    location /wizard-os-home/ {
      location ~ /\. { return 404; }
      alias /usr/share/nginx/wizard-ux/; include /tmp/wizard-static.conf;
    }
    location /wizard-ux/ {
      location ~ /\. { return 404; }
      alias /usr/share/nginx/wizard-ux/; include /tmp/wizard-static.conf;
    }

    # Everything else (/wizard/..., /api/..., /v1/...) is the Agent Service API, streamed.
    location / { proxy_pass $wizard_api$request_uri; include /tmp/wizard-proxy.conf; }
  }
}
