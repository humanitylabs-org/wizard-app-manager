  "date": "2026-10-19",
  "about": "0.3.0 plus the installer fix that runs wam/wizard with a python3 that has PyYAML (first live agent-run root install failed on the agent's bundled Python). Split UX / Agent Service / App Manager install snapshot with the agent-run installer (get.sh start/status, Tailscale owner action, deferred Hermes restart) and the AI connection slot replacing AI Accounts. Component versions remain independent. This manifest proves source and public image identities, not fresh-box or production acceptance.",
  "install": {
    "command": "curl -fsSL aiwizards.com/os.sh | bash",
    "agent": {
      "instructions": "https://aiwizards.com/os.md",
      "start": "curl -fsSL https://aiwizards.com/os.sh | bash -s start",
      "status": "curl -fsSL https://aiwizards.com/os.sh | bash -s status",
      "check": "curl -fsSL https://aiwizards.com/os.sh | WIZARD_CHECK=1 bash"
    },
    "modes": {
      "fresh": "blank Ubuntu/Debian box: Runtipi + App Manager + the default app in every spot (including hermes-agent)",
      "alongside": "box that already runs Hermes (run as its owner): App Manager + apps + the Wizard shell pointed at that Hermes; `wizard link` connects it, `wizard unlink` reverses it byte for byte"
    },
    "note": "Alongside mode consumes the split image pins. Fresh mode still installs catalog defaults and reports image drift. No catalog release is changed by this snapshot."
  },
