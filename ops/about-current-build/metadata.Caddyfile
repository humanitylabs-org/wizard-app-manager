# Narrow generated build stamp. My release remains absent/unselected.
handle /wizard-os-home/build.json {
    route {
        request_header -X-Wizard-Owner-Proof
        request_header -Tailscale-User-Login
        request_header -Tailscale-User-Name
        request_header -X-Private-Peer
        forward_auth 127.0.0.1:19447 {
            uri /verify?
            header_up X-Private-Peer {http.request.remote.host}
            header_up -Origin
            header_up -Sec-Fetch-Site
            copy_headers Tailscale-User-Login
            transport http {
                keepalive off
            }
        }
        @badBuildMethod not method GET
        respond @badBuildMethod 405
        @foreignBuildOrigin expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != "https://wizard.tailc0f369.ts.net"`
        respond @foreignBuildOrigin 403
        @crossSiteBuild header Sec-Fetch-Site cross-site
        respond @crossSiteBuild 403
        @buildQuery expression `{http.request.uri.query} != ""`
        respond @buildQuery 400
        # Same static origin as the shell: never derive identity from current.
        header {
            Cache-Control "private, no-store"
            X-Content-Type-Options nosniff
            X-Robots-Tag "noindex, nofollow"
            -ETag
            -Last-Modified
            defer
        }
        reverse_proxy __SHELL_STATIC_UPSTREAM__ {
            header_up -Cookie
            header_up -Authorization
            header_up -Tailscale-User-Login
            header_up -Tailscale-User-Name
            header_up -X-Private-Peer
            header_up -X-Wizard-Owner-Proof
        }
    }
}
