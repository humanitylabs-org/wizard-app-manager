#!/usr/bin/python3 -I
"""Owner-only CLI, launched from the reviewed protected management checkout."""
import os
from pathlib import Path
import sys
if os.getuid() != 0:
    raise SystemExit('An owner root session is required; no credentials are accepted on the command line.')
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from wam.credential_rotation import entrypoint
sys.exit(entrypoint())
