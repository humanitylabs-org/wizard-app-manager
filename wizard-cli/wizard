#!/usr/bin/env python3
"""wizard: the generic Wizard OS CLI. List installed apps, read their MCP tools, call one.

    wizard apps list [--json]
    wizard tools <app>[.<tool>] [--json]
    wizard call <app>.<tool> [ARGS] [--json]      ARGS: a JSON object, '-' for stdin, or @file
    wizard link [--restart]       connect this box's existing Hermes to the apps (stock-config edits, recorded)
    wizard unlink [--restart]     reverse exactly what `link` changed (config.yaml back byte for byte)
    wizard doctor [--gate]        PASS/FAIL lines plus one live request through the bridge

Contract: spec/WIZARD_CLI.md. Stdlib only, Python 3.9+. Reads the installed-app registry
(spec/APPS_JSON.md) and speaks MCP streamable HTTP to each app. Never prints credentials.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

VERSION = "0.2.0"
MARKER = "wizard-os-generic-cli"  # lets the installer recognise its own copy
PROTOCOL = "2025-06-18"
SUPPORTED_TRANSPORTS = ("streamable-http",)

# Exit codes (spec/WIZARD_CLI.md). Stable: scripts may branch on them.
EXIT = {
    "usage": 2, "bad_arguments": 2,
    "registry_not_found": 3, "registry_invalid": 3,
    "app_not_found": 4,
    "app_not_running": 5, "app_has_no_mcp": 5, "unsupported_transport": 5,
    "tool_not_found": 6,
    "unreachable": 7, "http_error": 7, "protocol_error": 7, "timeout": 7,
    "auth_failed": 8, "auth_missing": 8,
    "tool_error": 9,
}


class Fail(Exception):
    def __init__(self, code: str, message: str, **detail):
        super().__init__(message)
        self.code, self.message, self.detail = code, message, detail

    @property
    def exit(self) -> int:
        return EXIT.get(self.code, 1)


# ------------------------------------------------------------------ registry

def os_home() -> Path:
    return Path(os.environ.get("WIZARD_OS_HOME") or Path.home() / ".wizard-os").expanduser()


def registry_path(arg: str | None) -> Path:
    if arg:
        return Path(arg).expanduser()
    if os.environ.get("WIZARD_APPS_JSON"):
        return Path(os.environ["WIZARD_APPS_JSON"]).expanduser()
    return os_home() / "apps.json"


def load_registry(path: Path) -> dict:
    if not path.is_file():
        raise Fail("registry_not_found", f"no installed-app registry at {path} (is the App Manager installed?)",
                   registry=str(path))
    try:
        reg = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        raise Fail("registry_invalid", f"cannot read {path}: {e}", registry=str(path))
    if not isinstance(reg, dict) or not isinstance(reg.get("apps", []), list):
        raise Fail("registry_invalid", f"{path} is not an apps.json registry (no 'apps' list)", registry=str(path))
    reg.setdefault("apps", [])
    return reg


def redact_url(url: str | None) -> str | None:
    """Drop any user:password@ and query string so URLs are safe to print."""
    if not url:
        return url
    try:
        p = urllib.parse.urlsplit(url)
    except ValueError:
        return "<invalid url>"
    host = p.hostname or ""
    if p.port:
        host = f"{host}:{p.port}"
    return urllib.parse.urlunsplit((p.scheme, host, p.path, "", ""))


def public_app(a: dict) -> dict:
    """Registry row as printed: private (_-prefixed) fields and MCP auth details removed."""
    out = {k: v for k, v in a.items() if not str(k).startswith("_")}
    mcp = a.get("mcp")
    if isinstance(mcp, dict):
        out["mcp"] = {"url": redact_url(mcp.get("url")), "internal": redact_url(mcp.get("internal")),
                      "transport": mcp.get("transport", "streamable-http"),
                      "auth": (mcp.get("auth") or {}).get("type") if isinstance(mcp.get("auth"), dict) else None}
    out["callable"] = callable_reason(a) is None
    return out


def callable_reason(a: dict) -> Fail | None:
    st = a.get("status")
    if st is not None and st != "running":
        return Fail("app_not_running", f"{a.get('id')} is {st}, not running (start it in the Apps screen or `wam`)",
                    app=a.get("id"), status=st)
    mcp = a.get("mcp")
    if not isinstance(mcp, dict) or not (mcp.get("url") or mcp.get("internal")):
        return Fail("app_has_no_mcp", f"{a.get('id')} has no MCP endpoint (it is a view-only app)", app=a.get("id"))
    tr = mcp.get("transport", "streamable-http")
    if tr not in SUPPORTED_TRANSPORTS:
        return Fail("unsupported_transport", f"{a.get('id')} speaks MCP over '{tr}'; this CLI supports "
                    + ", ".join(SUPPORTED_TRANSPORTS), app=a.get("id"), transport=tr)
    return None


def find_app(reg: dict, app_id: str) -> dict:
    for a in reg["apps"]:
        if isinstance(a, dict) and a.get("id") == app_id:
            return a
    known = sorted(str(a.get("id")) for a in reg["apps"] if isinstance(a, dict))
    raise Fail("app_not_found", f"no installed app '{app_id}'" + (f" (installed: {', '.join(known)})" if known
                                                                    else " (no apps installed)"),
               app=app_id, installed=known)


# ------------------------------------------------------------------ auth

def env_key(app_id: str) -> str:
    return "WIZARD_MCP_TOKEN_" + re.sub(r"[^A-Z0-9]", "_", app_id.upper())


def bearer_for(a: dict) -> str | None:
    """Token from existing box configuration, never from argv (argv shows up in `ps`).

    1. env WIZARD_MCP_TOKEN_<APP_ID> (e.g. WIZARD_MCP_TOKEN_DEFLEUR_VIDEO)
    2. registry mcp.auth = {"type": "bearer", "secret": "<KEY>"} -> $WIZARD_OS_HOME/secrets/<id>.json [KEY]
       (the file the App Manager already writes 0600 for generated app passwords)
       or {"type": "bearer", "env": "<VAR>"} -> that environment variable.
    """
    app_id = str(a.get("id"))
    tok = os.environ.get(env_key(app_id))
    if tok:
        return tok
    auth = (a.get("mcp") or {}).get("auth")
    if not isinstance(auth, dict) or not auth:
        return None
    if auth.get("type", "bearer") != "bearer":
        raise Fail("unsupported_transport", f"{app_id} wants MCP auth '{auth.get('type')}'; only bearer is supported",
                   app=app_id)
    if auth.get("env"):
        tok = os.environ.get(str(auth["env"]))
        if not tok:
            raise Fail("auth_missing", f"{app_id} needs a token in ${auth['env']} (not set)", app=app_id)
        return tok
    key = str(auth.get("secret") or "MCP_TOKEN")
    f = os_home() / "secrets" / f"{app_id}.json"
    try:
        tok = json.loads(f.read_text(encoding="utf-8")).get(key)
    except (OSError, ValueError, AttributeError):
        tok = None
    if not tok:
        raise Fail("auth_missing", f"{app_id} needs a token: set {env_key(app_id)} or add '{key}' to {f}", app=app_id)
    return str(tok)


# ------------------------------------------------------------------ MCP client (streamable HTTP)

class MCP:
    def __init__(self, app: dict, endpoint: str, timeout: float):
        mcp = app["mcp"]
        url = mcp.get(endpoint) or mcp.get("url") or mcp.get("internal")
        if urllib.parse.urlsplit(url).scheme not in ("http", "https"):
            raise Fail("unsupported_transport", f"{app['id']} MCP url is not http(s)", app=app["id"])
        self.app_id, self.url, self.timeout = app["id"], url, timeout
        self.token = bearer_for(app)
        self.session: str | None = None
        self.proto: str | None = None
        self.next_id = 0
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # box-local: never via a proxy

    def _post(self, msg: dict) -> tuple[int, dict, bytes]:
        h = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
             "User-Agent": f"wizard-cli/{VERSION}"}
        if self.token:
            h["Authorization"] = f"Bearer {self.token}"
        if self.session:
            h["Mcp-Session-Id"] = self.session
        if self.proto:
            h["MCP-Protocol-Version"] = self.proto
        req = urllib.request.Request(self.url, data=json.dumps(msg).encode(), headers=h, method="POST")
        where = redact_url(self.url)
        try:
            with self.opener.open(req, timeout=self.timeout) as r:
                return r.status, {k.lower(): v for k, v in r.headers.items()}, r.read()
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                raise Fail("auth_failed", f"{self.app_id} refused the call (HTTP {e.code}) at {where}"
                           + ("" if self.token else f"; set {env_key(self.app_id)} if it needs a token"),
                           app=self.app_id, status=e.code)
            body = e.read()[:300].decode("utf-8", "replace")
            raise Fail("http_error", f"{self.app_id} returned HTTP {e.code} at {where}: {body}".strip(),
                       app=self.app_id, status=e.code)
        except (TimeoutError, OSError) as e:
            reason = getattr(e, "reason", e)
            if isinstance(reason, TimeoutError) or "timed out" in str(reason):
                raise Fail("timeout", f"{self.app_id} did not answer within {self.timeout:g}s at {where}",
                           app=self.app_id)
            raise Fail("unreachable", f"cannot reach {self.app_id} at {where}: {reason}", app=self.app_id)

    def _decode(self, headers: dict, body: bytes, want_id: int) -> dict:
        ctype = headers.get("content-type", "")
        msgs: list = []
        try:
            if "text/event-stream" in ctype:
                data: list[str] = []
                for line in body.decode("utf-8", "replace").splitlines() + [""]:
                    if line.startswith("data:"):
                        data.append(line[5:].lstrip())
                    elif not line.strip() and data:
                        msgs.append(json.loads("\n".join(data)))
                        data = []
            else:
                parsed = json.loads(body or b"null")
                msgs = parsed if isinstance(parsed, list) else [parsed]
        except ValueError as e:
            raise Fail("protocol_error", f"{self.app_id} sent a reply that is not JSON-RPC: {e}", app=self.app_id)
        for m in msgs:
            if isinstance(m, dict) and m.get("id") == want_id and ("result" in m or "error" in m):
                return m
        raise Fail("protocol_error", f"{self.app_id} sent no JSON-RPC reply for request {want_id}", app=self.app_id)

    def request(self, method: str, params: dict | None = None) -> dict:
        self.next_id += 1
        msg = {"jsonrpc": "2.0", "id": self.next_id, "method": method}
        if params is not None:
            msg["params"] = params
        status, headers, body = self._post(msg)
        if headers.get("mcp-session-id"):
            self.session = headers["mcp-session-id"]
        reply = self._decode(headers, body, self.next_id)
        if "error" in reply:
            err = reply["error"] or {}
            raise Fail("tool_error" if method == "tools/call" else "protocol_error",
                       f"{self.app_id} {method} failed: {err.get('message', err)}", app=self.app_id,
                       rpc_code=err.get("code"), rpc_data=err.get("data"))
        return reply.get("result") or {}

    def notify(self, method: str) -> None:
        self._post({"jsonrpc": "2.0", "method": method})

    def open(self) -> dict:
        info = self.request("initialize", {"protocolVersion": PROTOCOL, "capabilities": {},
                                           "clientInfo": {"name": "wizard-cli", "version": VERSION}})
        self.proto = info.get("protocolVersion") or PROTOCOL
        self.notify("notifications/initialized")
        return info

    def close(self) -> None:
        if not self.session:
            return
        h = {"Mcp-Session-Id": self.session}
        if self.token:
            h["Authorization"] = f"Bearer {self.token}"
        try:
            self.opener.open(urllib.request.Request(self.url, headers=h, method="DELETE"), timeout=5).close()
        except Exception:  # noqa: BLE001 - ending a session is best effort
            pass

    def tools(self) -> list[dict]:
        out, cursor = [], None
        for _ in range(100):
            res = self.request("tools/list", {"cursor": cursor} if cursor else None)
            out += [t for t in res.get("tools") or [] if isinstance(t, dict)]
            cursor = res.get("nextCursor")
            if not cursor:
                break
        return out


def connect(reg: dict, app_id: str, endpoint: str, timeout: float) -> MCP:
    a = find_app(reg, app_id)
    why = callable_reason(a)
    if why:
        raise why
    c = MCP(a, endpoint, timeout)
    c.open()
    return c


# ------------------------------------------------------------------ arguments

def split_target(target: str, need_tool: bool) -> tuple[str, str | None]:
    app, dot, tool = target.partition(".")
    if not app or (dot and not tool):
        raise Fail("usage", f"'{target}' is not <app> or <app>.<tool>")
    if need_tool and not tool:
        raise Fail("usage", f"name a tool: wizard call {app}.<tool> (see `wizard tools {app}`)")
    return app, tool or None


def parse_args_json(raw: str | None) -> dict:
    if raw is None:
        return {}
    src = "ARGS"
    if raw == "-":
        raw, src = sys.stdin.read(), "stdin"
    elif raw.startswith("@"):
        src = raw[1:]
        try:
            raw = Path(src).expanduser().read_text(encoding="utf-8")
        except OSError as e:
            raise Fail("bad_arguments", f"cannot read arguments file {src}: {e}")
    try:
        val = json.loads(raw) if raw.strip() else {}
    except ValueError as e:
        raise Fail("bad_arguments", f"tool arguments from {src} are not valid JSON: {e}")
    if not isinstance(val, dict):
        raise Fail("bad_arguments", f"tool arguments must be a JSON object, got {type(val).__name__}")
    return val


JSON_TYPES = {"string": str, "integer": int, "number": (int, float), "boolean": bool, "object": dict,
              "array": list, "null": type(None)}


def check_args(tool: dict, args: dict) -> None:
    """Catch the obvious mistakes locally (missing required, wrong top-level type, unknown key when the
    schema forbids extras). The app's own validation still runs."""
    s = tool.get("inputSchema") or {}
    props = s.get("properties") or {}
    missing = [k for k in s.get("required") or [] if k not in args]
    if missing:
        raise Fail("bad_arguments", f"{tool['name']} needs {', '.join(missing)}", missing=missing)
    if s.get("additionalProperties") is False:
        extra = sorted(k for k in args if k not in props)
        if extra:
            raise Fail("bad_arguments", f"{tool['name']} does not take {', '.join(extra)}", unexpected=extra)
    for k, v in args.items():
        spec = props.get(k) or {}
        types = spec.get("type")
        if not types and isinstance(spec.get("anyOf"), list):
            types = [t.get("type") for t in spec["anyOf"] if isinstance(t, dict)]
        if not types:
            continue
        types = types if isinstance(types, list) else [types]
        ok = []
        for t in types:
            py = JSON_TYPES.get(t)
            if py is None:
                ok.append(True)
            elif t in ("integer", "number") and isinstance(v, bool):
                ok.append(False)
            else:
                ok.append(isinstance(v, py))
        if not any(ok):
            raise Fail("bad_arguments", f"{tool['name']}: '{k}' should be {' or '.join(map(str, types))}",
                       argument=k)


# ------------------------------------------------------------------ commands

def cmd_apps_list(ns) -> dict:
    path = registry_path(ns.registry)
    reg = load_registry(path)
    return {"ok": True, "registry": str(path), "schema": reg.get("schema"),
            "apps": [public_app(a) for a in reg["apps"] if isinstance(a, dict)]}


def tool_brief(t: dict) -> dict:
    return {k: t[k] for k in ("name", "title", "description", "inputSchema", "outputSchema", "annotations") if k in t}


def cmd_tools(ns) -> dict:
    app_id, tool = split_target(ns.target, need_tool=False)
    reg = load_registry(registry_path(ns.registry))
    c = connect(reg, app_id, ns.endpoint, ns.timeout)
    try:
        tools = c.tools()
    finally:
        c.close()
    if tool:
        t = resolve_tool(app_id, tools, tool)
        return {"ok": True, "app": app_id, "tool": tool_brief(t)}
    return {"ok": True, "app": app_id, "tools": [tool_brief(t) for t in tools]}


def resolve_tool(app_id: str, tools: list[dict], name: str) -> dict:
    for t in tools:
        if t.get("name") == name:
            return t
    names = sorted(str(t.get("name")) for t in tools)
    near = [n for n in names if name.lower() in n.lower() or n.lower() in name.lower()]
    raise Fail("tool_not_found", f"{app_id} has no tool '{name}'" + (f"; did you mean {', '.join(near)}?" if near
                                                                      else f"; it has: {', '.join(names)}"),
               app=app_id, tool=name, tools=names)


def cmd_call(ns) -> dict:
    app_id, tool = split_target(ns.target, need_tool=True)
    args = parse_args_json(ns.args)  # bad JSON fails before any network I/O
    reg = load_registry(registry_path(ns.registry))
    c = connect(reg, app_id, ns.endpoint, ns.timeout)
    try:
        t = resolve_tool(app_id, c.tools(), tool)
        check_args(t, args)
        res = c.request("tools/call", {"name": tool, "arguments": args})
    finally:
        c.close()
    texts = [b.get("text", "") for b in res.get("content") or [] if isinstance(b, dict) and b.get("type") == "text"]
    data = res.get("structuredContent")
    if data is None and len(texts) == 1:
        try:
            data = json.loads(texts[0])
        except ValueError:
            data = None
    out = {"ok": not res.get("isError"), "app": app_id, "tool": tool, "arguments": args,
           "text": "\n".join(texts), "data": data, "result": res}
    if res.get("isError"):
        raise Fail("tool_error", f"{app_id}.{tool} reported an error: {out['text'][:500]}", app=app_id, tool=tool,
                   result=res)
    return out


# ------------------------------------------------------------------ output
# ------------------------------------------------------------------ link / unlink / doctor (alongside mode)
#
# spec/AGENT_BRIDGE.md "Installing over an existing Hermes": `wizard link` connects the owner's existing Hermes to
# this box's apps with stock-config edits only, each recorded in $WIZARD_OS_HOME/linked.json so `wizard unlink`
# reverses exactly them. Every config write goes through Hermes' own `hermes config` / `hermes plugins` commands.
# Secrets (the gateway token, a generated API key) go into the Hermes .env (0600), never into argv or output.

LINK_FILE = "linked.json"
MCP_NAME = "wizard"
PLUGIN_NAME = "wizard-os"
TOKEN_ENV = "WIZARD_MCP_TOKEN"
PLUGIN_SOURCE = "humanitylabs-org/wizard-agent-service#hermes-plugin/wizard-os"
DEFAULT_SHELL_PORT = 8796


def hermes_home_path(arg: str | None = None) -> Path:
    return Path(arg or os.environ.get("HERMES_HOME") or Path.home() / ".hermes").expanduser()


def hermes_bin() -> str:
    import shutil
    found = os.environ.get("WIZARD_HERMES_BIN") or shutil.which("hermes") or str(Path.home() / ".local" / "bin" / "hermes")
    if not Path(found).is_file():
        raise Fail("usage", "no `hermes` command on this box (link needs an existing Hermes)")
    return found


def run_hermes(home: Path, *args: str, check: bool = True, timeout: int = 300) -> "subprocess.CompletedProcess":
    import subprocess
    env = {**os.environ, "HERMES_HOME": str(home), "NO_COLOR": "1"}
    p = subprocess.run([hermes_bin(), *args], capture_output=True, text=True, env=env, timeout=timeout,
                       stdin=subprocess.DEVNULL)
    if check and p.returncode != 0:
        tail = "\n".join((p.stderr or p.stdout or "").strip().splitlines()[-3:])
        raise Fail("tool_error", f"`hermes {' '.join(args[:3])}` failed: {tail}")
    return p


def hcfg_get(home: Path, key: str):
    """Value as the owner's Hermes sees it (raw config, no defaults merged for missing keys), or KeyError."""
    p = run_hermes(home, "config", "get", key, "--json", check=False)
    if p.returncode != 0:
        raise KeyError(key)
    try:
        return json.loads(p.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise KeyError(key)


def raw_config(home: Path) -> dict:
    """The owner's config.yaml as written (PyYAML when present; {} if unreadable)."""
    try:
        import yaml  # python3-yaml ships with Wizard OS boxes; only used to read
        return yaml.safe_load((home / "config.yaml").read_text(encoding="utf-8")) or {}
    except Exception:  # noqa: BLE001
        return {}


def raw_get(cfg: dict, key: str):
    cur = cfg
    for part in key.split("."):
        if not isinstance(cur, dict) or part not in cur:
            raise KeyError(key)
        cur = cur[part]
    return cur


# A minimal-diff YAML edit: ruamel (Hermes' own dependency, run in Hermes' venv) computes the edited document, and
# only the lines that changed are spliced into the original bytes, so comments, blank lines, quoting and every
# key Wizard OS doesn't own stay exactly as the owner wrote them. (`hermes config set` would also normalise
# unrelated lines and materialise defaults.)
_EDITOR = r"""
import difflib, io, json, sys
from ruamel.yaml import YAML
req = json.load(sys.stdin)
path, ops = req["path"], req["ops"]
y = YAML(); y.preserve_quotes = True; y.width = 4096; y.indent(mapping=2, sequence=4, offset=2)
src = open(path, encoding="utf-8").read()
def dump(d):
    o = io.StringIO(); y.dump(d, o); return o.getvalue()
doc = y.load(src)
if doc is None:
    from ruamel.yaml.comments import CommentedMap
    doc = CommentedMap()
base = dump(doc)
for op in ops:
    parts = op["key"].split(".")
    cur = doc
    if op["op"] == "set":
        for k in parts[:-1]:
            if not isinstance(cur.get(k), dict):
                cur[k] = {}
            cur = cur[k]
        cur[parts[-1]] = op["value"]
    else:
        chain = [doc]
        for k in parts[:-1]:
            if not isinstance(cur, dict) or k not in cur:
                cur = None; break
            cur = cur[k]; chain.append(cur)
        if isinstance(cur, dict) and parts[-1] in cur:
            del cur[parts[-1]]
            for i in range(len(parts) - 1, 0, -1):   # drop parents this left empty (they were created by link)
                if op.get("prune") and isinstance(chain[i], dict) and not chain[i]:
                    del chain[i - 1][parts[i - 1]]
                else:
                    break
new = dump(doc)
O, B, N = src.splitlines(True), base.splitlines(True), new.splitlines(True)
if len(O) == len(B):
    out = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, B, N, autojunk=False).get_opcodes():
        out += O[i1:i2] if tag == "equal" else N[j1:j2]
    text = "".join(out)
else:
    text = new
tmp = path + ".wizard-tmp"
import os, stat
mode = stat.S_IMODE(os.stat(path).st_mode) if os.path.exists(path) else 0o600
with open(tmp, "w", encoding="utf-8") as f:
    f.write(text)
os.chmod(tmp, mode)
os.replace(tmp, path)
print(json.dumps({"spliced": len(O) == len(B)}))
"""


def hermes_python(home: Path) -> str:
    """The Python inside the owner's Hermes install (it carries ruamel.yaml). Follows the `hermes` launcher: a
    shell shim that execs <venv>/bin/hermes, or a console script whose shebang names the interpreter."""
    import re as _re
    cands: list[str] = []
    seen: set[str] = set()
    todo = [hermes_bin()]
    while todo:
        f = str(Path(todo.pop()).resolve())
        if f in seen:
            continue
        seen.add(f)
        try:
            head = Path(f).read_text(encoding="utf-8", errors="replace")[:4000]
        except OSError:
            continue
        first = head.splitlines()[0] if head else ""
        if first.startswith("#!") and "python" in first:
            cands.append(first[2:].strip().split()[0])
        for m in _re.findall(r"(/[^\s\"']+)/bin/hermes\b", head):
            cands.append(f"{m}/bin/python")
            todo.append(f"{m}/bin/hermes")
    cands += [str(home / "hermes-agent" / "venv" / "bin" / "python"), str(Path.home() / ".hermes" / "hermes-agent" / "venv" / "bin" / "python")]
    for c in cands:
        if Path(c).is_file() and os.access(c, os.X_OK):
            return c
    raise Fail("usage", "can't find the Python inside this Hermes install (needed for a safe config edit)")


_PROBE_MODULE = "json.tool"


def editor_command(home: Path) -> list[str]:
    """How to run the config editor inside the owner's Hermes (it carries ruamel.yaml). Current installs publish
    their exact launch command (`hermes --print-runtime-command`: a managed Python plus a bootstrap that leases the
    dependencies); older ones have a plain venv Python."""
    import subprocess
    try:
        r = subprocess.run([hermes_bin(), "--print-runtime-command", "--module", _PROBE_MODULE], capture_output=True,
                           text=True, timeout=60, env=_hermes_env(home))
        cmd = json.loads(r.stdout.strip().splitlines()[-1]) if r.returncode == 0 and r.stdout.strip() else None
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        cmd = None
    run = f"runpy.run_module('{_PROBE_MODULE}', run_name='__main__', alter_sys=True)"
    if isinstance(cmd, list) and cmd and isinstance(cmd[-1], str) and cmd[-1].count(run) == 1:
        return cmd[:-1] + [cmd[-1].replace(run, f"exec({_EDITOR!r})")]
    return [hermes_python(home), "-c", _EDITOR]


def _hermes_env(home: Path) -> dict[str, str]:
    return {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", str(Path.home())), "HERMES_HOME": str(home)}


def yaml_edit(home: Path, ops: list[dict]) -> dict:
    import subprocess
    p = subprocess.run(editor_command(home), input=json.dumps({"path": str(home / "config.yaml"), "ops": ops}),
                       capture_output=True, text=True, timeout=120, env=_hermes_env(home))
    if p.returncode != 0:
        raise Fail("tool_error", "config edit failed: " + "\n".join((p.stderr or "").strip().splitlines()[-2:]))
    return json.loads(p.stdout.strip().splitlines()[-1])


def hcfg_set(home: Path, key: str, value) -> None:
    yaml_edit(home, [{"op": "set", "key": key, "value": value}])


def hcfg_unset(home: Path, key: str) -> None:
    yaml_edit(home, [{"op": "unset", "key": key, "prune": True}])


def sha256_file(p: Path) -> str | None:
    import hashlib
    try:
        return hashlib.sha256(p.read_bytes()).hexdigest()
    except OSError:
        return None


def env_names(p: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        for line in p.read_text(encoding="utf-8").splitlines():
            s = line.strip()
            if s and not s.startswith("#") and "=" in s:
                k, v = s.split("=", 1)
                out[k.strip().removeprefix("export ").strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def env_append(p: Path, name: str, value: str) -> None:
    text = p.read_text(encoding="utf-8") if p.is_file() else ""
    if text and not text.endswith("\n"):
        text += "\n"
    text += f"{name}={value}\n"
    tmp = p.with_name(p.name + ".wizard-tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    tmp.replace(p)


def env_remove(p: Path, names: list[str]) -> None:
    if not p.is_file():
        return
    keep = [ln for ln in p.read_text(encoding="utf-8").splitlines(keepends=True)
            if not (("=" in ln) and ln.split("=", 1)[0].strip().removeprefix("export ").strip() in names)]
    tmp = p.with_name(p.name + ".wizard-tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("".join(keep))
    tmp.replace(p)


def secret_file(path: Path) -> str:
    """Read a 0600 token file, creating it with a fresh random token if missing."""
    import secrets as _s
    try:
        t = path.read_text(encoding="utf-8").strip()
        if t:
            return t
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    t = _s.token_urlsafe(32)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(t + "\n")
    return t


def alongside_state() -> dict:
    try:
        return json.loads((os_home() / "alongside.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def gateway_url(ns) -> str:
    if getattr(ns, "url", None):
        return ns.url
    port = (alongside_state().get("shell") or {}).get("port") or DEFAULT_SHELL_PORT
    return f"http://127.0.0.1:{int(port)}/wizard/mcp"


def mcp_entry(url: str) -> dict:
    return {"url": url, "headers": {"Authorization": f"Bearer ${{{TOKEN_ENV}}}"}}


def read_record() -> dict | None:
    try:
        rec = json.loads((os_home() / LINK_FILE).read_text(encoding="utf-8"))
        return rec if isinstance(rec, dict) else None
    except (OSError, ValueError):
        return None


def link_record() -> dict | None:
    rec = read_record()
    return rec if rec and rec.get("linked") else None


def pending_record() -> dict | None:
    """A link that started but never finished (a failure the rollback couldn't complete, or the process was
    killed). Its journal lists every edit that may have landed, so it can be rolled back."""
    rec = read_record()
    return rec if rec and rec.get("state") == "linking" else None


def save_record(rec: dict) -> None:
    """Durable, atomic write of the link journal (0600): a reader sees the old or the new record, never half."""
    p = os_home() / LINK_FILE
    tmp = p.with_name(p.name + ".wizard-tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(json.dumps(rec, indent=2) + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, p)


class link_lock:
    """One `wizard link` / `unlink` at a time (an installer re-run and the owner typing `wizard unlink`, say):
    both read and write linked.json and the Hermes config, so a second run fails fast instead of rolling the
    first one's journal back mid-edit. flock is released by the kernel when the process dies, kill included."""

    def __enter__(self):
        import fcntl
        p = os_home() / (LINK_FILE + ".lock")
        p.parent.mkdir(parents=True, exist_ok=True)
        self.fd = os.open(p, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            raise Fail("usage", "another `wizard link` or `wizard unlink` is running on this box; wait for it to "
                                "finish, then try again", stage="locked") from None
        return self

    def __exit__(self, *exc):
        os.close(self.fd)   # closing the descriptor drops the lock
        return False


def restore_bytes(src: Path, dst: Path) -> None:
    """Put a backup back atomically (mode and bytes as backed up)."""
    import shutil
    tmp = dst.with_name(dst.name + ".wizard-tmp")
    shutil.copy2(src, tmp)
    os.replace(tmp, dst)


def rollback_link(rec: dict) -> dict:
    """Undo an unfinished link from its journal. Files still in a state link itself produced get their backed-up
    bytes back; anything the owner changed meanwhile keeps the owner's edits and loses only Wizard OS's."""
    home = Path(rec["hermes_home"])
    cfgp, envp, bdir = home / "config.yaml", home / ".env", Path(rec["backup"])
    for stray in (home / "config.yaml.wizard-tmp", home / ".env.wizard-tmp"):
        try:
            stray.unlink()
        except OSError:
            pass
    if rec.get("plugin_installed"):
        remove_installed_plugin(home, rec)
    backup_cfg = bdir / "config.yaml"
    backup_ok = sha256_file(backup_cfg) == rec.get("config_sha_before")
    if backup_ok and sha256_file(cfgp) in (rec.get("known_config_shas") or []):
        restore_bytes(backup_cfg, cfgp)   # only link touched it: the owner's original bytes go straight back
    else:   # the owner edited it too: reverse only Wizard OS's keys, keep theirs
        for e in reversed(rec.get("edits") or []):
            reverse_edit(home, e)
        try:
            import yaml
            same = _semantic(yaml.safe_load(cfgp.read_text(encoding="utf-8")) or {}) == \
                _semantic(yaml.safe_load(backup_cfg.read_text(encoding="utf-8")) or {})
        except Exception:  # noqa: BLE001
            same = False
        if same and backup_ok:
            restore_bytes(backup_cfg, cfgp)
    known_env = rec.get("known_env_shas") or []
    if rec.get("env_existed"):
        if sha256_file(envp) in known_env and sha256_file(bdir / ".env") == rec.get("env_sha_before"):
            restore_bytes(bdir / ".env", envp)
        else:
            env_remove(envp, rec.get("env_added") or [])
    elif envp.is_file():
        if sha256_file(envp) in known_env:
            envp.unlink()
        else:
            env_remove(envp, rec.get("env_added") or [])
            if not envp.read_text(encoding="utf-8").strip():   # nothing of the owner's in it: there was no .env
                envp.unlink()
    config_ok = sha256_file(cfgp) == rec.get("config_sha_before")
    env_ok = sha256_file(envp) == rec.get("env_sha_before")
    rec.update(state="rolled_back", linked=False,
               rolled_back={"config_byte_identical": config_ok, "env_byte_identical": env_ok})
    save_record(rec)
    return {"config_byte_identical": config_ok, "env_byte_identical": env_ok,
            "plugin_removed": bool(rec.get("plugin_installed"))}


def builder_module():
    # The standalone CLI uses the OS bundle after installation, the adjacent
    # source only in a complete checkout. No developer PYTHONPATH is required.
    roots = [Path(__file__).resolve().parent.parent, os_home() / 'builder/current']
    for root in roots:
        if (root / 'wam/builder_bundle.py').is_file():
            sys.path.insert(0, str(root))
            from wam import builder_bundle
            return builder_bundle
    raise Fail('tool_error', 'Stock builder bundle is missing; reinstall Wizard App Manager')


def plugin_fingerprint(home):
    return plugin_tree_fingerprint(home / 'plugins' / PLUGIN_NAME)


def plugin_tree_fingerprint(root):
    import hashlib
    files = {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
             for p in sorted(root.rglob('*')) if p.is_file() and '.git' not in p.parts
             and '__pycache__' not in p.parts and p.suffix != '.pyc'}
    return hashlib.sha256(json.dumps(files, sort_keys=True).encode()).hexdigest()


def attest_legacy_plugin(home, rec):
    """An old managed link has no fingerprint: compare against its recorded Git
    revision, not today's upstream or a guessed owner path. Any difference stops.
    """
    import subprocess
    import tempfile
    try:
        metadata = json.loads((home / 'plugins/.install-metadata.json').read_text())[PLUGIN_NAME]
        revision, source = metadata['revision'], metadata['source']
        if not re.fullmatch(r'[0-9a-f]{40}', revision) or source != PLUGIN_SOURCE:
            raise ValueError('unknown source or unpinned installed revision')
        repo, subdir = source.split('#', 1)
        with tempfile.TemporaryDirectory(prefix='.plugin-attest-', dir=os_home()) as td:
            root = Path(td)
            for args in (['init', '-q', td], ['-C', td, 'fetch', '-q', '--depth=1', 'https://github.com/' + repo + '.git', revision],
                         ['-C', td, 'checkout', '-q', '--detach', 'FETCH_HEAD']):
                subprocess.run(['git', *args], check=True, capture_output=True, timeout=120)
            if plugin_tree_fingerprint(root / subdir) != plugin_fingerprint(home):
                raise ValueError('plugin differs from its recorded upstream revision')
        rec['plugin_sha256'] = plugin_fingerprint(home)
        # Pre-bundle link records omitted plugin_ref. Preserve an explicitly
        # pinned stock install when migrating its attested ownership record.
        if 'plugin_ref' not in rec and metadata.get('pinned'):
            rec['plugin_ref'] = revision
        save_record(rec)
    except (KeyError, ValueError, OSError, subprocess.SubprocessError) as e:
        raise Fail('tool_error', f'Cannot attest existing wizard-os plugin; preserving it ({e}). '
                   'Review/back up the owner plugin before replacing it.') from None


def refresh_owned_plugin(home, rec, ns):
    """Refresh only a plugin whose last installed bytes we can attest."""
    import shutil
    root = home / 'plugins' / PLUGIN_NAME
    if not rec.get('plugin_installed'):
        raise Fail('tool_error', 'Existing wizard-os plugin is owner-managed; preserving it. Update it explicitly before relinking.')
    if not rec.get('plugin_sha256'):
        attest_legacy_plugin(home, rec)
    if plugin_fingerprint(home) != rec['plugin_sha256']:
        raise Fail('tool_error', 'Owner modified wizard-os plugin; preserving it. Review changes before upgrading.')
    backup = Path(rec['backup']) / 'plugin-before-refresh'
    if backup.exists():
        raise Fail('tool_error', f'Unfinished plugin refresh: preserved backup at {backup}; recover before retrying')
    shutil.copytree(root, backup, symlinks=True)
    try:
        args = ['plugins', 'install', ns.plugin_source or PLUGIN_SOURCE, '--force', '--no-enable']
        ref = ns.plugin_ref or rec.get('plugin_ref')
        if ref:
            args += ['--ref', ref]
        run_hermes(home, *args)
    except BaseException:
        shutil.rmtree(root, ignore_errors=True)
        shutil.copytree(backup, root, symlinks=True)
        shutil.rmtree(backup)
        raise
    shutil.rmtree(backup)
    rec['plugin_ref'] = ref
    rec['plugin_sha256'] = plugin_fingerprint(home)
    save_record(rec)


def reverse_edit(home, e):
    if e['key'] == 'skills.external_dirs':
        try:
            now = list(raw_get(raw_config(home), e['key']) or [])
        except KeyError:
            now = []
        before = e['before'].get('value') or []
        added = [d for d in e['after'] if d not in before]
        kept = [d for d in now if d not in added]
        if kept or e['before']['present']:
            hcfg_set(home, e['key'], kept)
        else:
            hcfg_unset(home, e['key'])
    elif e['before']['present']:
        hcfg_set(home, e['key'], e['before']['value'])
    else:
        hcfg_unset(home, e['key'])


def cmd_link(ns) -> dict:
    import shutil
    import time as _t
    home = hermes_home_path(ns.hermes_home)
    cfgp, envp = home / "config.yaml", home / ".env"
    if not cfgp.is_file():
        raise Fail("usage", f"no Hermes config at {cfgp}")
    bb = builder_module()
    if (home / 'plugins' / PLUGIN_NAME).exists() and not link_record() and not pending_record():
        raise Fail('tool_error', 'Owner-managed wizard-os plugin already exists; preserving it. Review it before linking.')
    try:
        bb.check_collisions(home, os_home(), raw_config(home))
        builder = bb.install(os_home())
    except (ValueError, OSError) as e:
        raise Fail('tool_error', str(e)) from None
    if rec := link_record():
        if Path(rec['hermes_home']) != home:
            raise Fail('usage', 'Wizard OS is linked to a different Hermes home; unlink it first')
        refresh_owned_plugin(home, rec, ns)
        dirs = list((raw_config(home).get('skills') or {}).get('external_dirs') or [])
        wanted = [str(os_home() / 'skills'), builder['system_skills']]
        after = dirs + [d for d in wanted if d not in dirs]
        if after != dirs:
            rec['edits'].append({'key': 'skills.external_dirs', 'before': {'present': bool(dirs), 'value': dirs}, 'after': after})
            save_record(rec)
            hcfg_set(home, 'skills.external_dirs', after)
        rec['config_sha_after'] = sha256_file(cfgp)
        save_record(rec)
        restarted = ns.restart and run_hermes(home, 'gateway', 'restart', check=False, timeout=180).returncode == 0
        return {"ok": True, "already_linked": True, 'builder': builder, 'plugin_refreshed': True,
                'gateway_restarted': bool(restarted), "record": str(os_home() / LINK_FILE)}
    recovered = None
    if pending_record():   # an earlier link died half-way: put the owner's files back before starting again
        recovered = rollback_link(pending_record())
    osh = os_home()
    osh.mkdir(parents=True, exist_ok=True)
    (osh / "skills").mkdir(exist_ok=True)
    url = gateway_url(ns)
    token = secret_file(osh / "mcp-token")
    cfg = raw_config(home)
    try:
        existing = raw_get(cfg, f"mcp_servers.{MCP_NAME}")
    except KeyError:
        existing = None
    if existing is not None and not (isinstance(existing, dict) and "/wizard/mcp" in str(existing.get("url", ""))):
        raise Fail("usage", f"this Hermes already has an MCP server called '{MCP_NAME}' that isn't Wizard OS; "
                            "left it alone (rename it, then link)")
    stamp = _t.strftime("%Y%m%dT%H%M%SZ", _t.gmtime())
    bdir = osh / "link-backup" / stamp
    n = 1
    while bdir.exists():   # a quick retry after a rolled-back link lands in the same second
        bdir, n = osh / "link-backup" / f"{stamp}-{n}", n + 1
    bdir.mkdir(parents=True, mode=0o700)
    shutil.copy2(cfgp, bdir / "config.yaml")
    env_existed = envp.is_file()
    if env_existed:
        shutil.copy2(envp, bdir / ".env")
    os.chmod(bdir, 0o700)
    # The journal is written (fsync'd) before the first edit, and every edit is added to it *before* it is made,
    # so a failure or a kill at any point leaves a record that `wizard link` / `wizard unlink` can roll back.
    # known_*_shas: every state of the two files that link itself produced (owner edits are anything else).
    rec = {"linked": False, "state": "linking", "version": 2, "linked_at": stamp, "hermes_home": str(home),
           "gateway": url, "backup": str(bdir), "config_sha_before": sha256_file(cfgp), "env_existed": env_existed,
           "env_sha_before": sha256_file(envp), "edits": [], "env_added": [], "plugin_installed": False,
           "plugins_dir_existed": (home / "plugins").is_dir(),
           "plugin_metadata_existed": (home / "plugins" / ".install-metadata.json").is_file(),
           "known_config_shas": [sha256_file(cfgp)], "known_env_shas": [sha256_file(envp)], "notes": []}
    save_record(rec)

    def produced() -> None:
        for key, path in (("known_config_shas", cfgp), ("known_env_shas", envp)):
            h = sha256_file(path)
            if h not in rec[key]:
                rec[key].append(h)
        save_record(rec)

    def remember(key: str, after) -> None:
        try:
            before = {"present": True, "value": raw_get(raw_config(home), key)}
        except KeyError:
            before = {"present": False}
        rec["edits"].append({"key": key, "before": before, "after": after})
        save_record(rec)
        fault(f"before:{key}")
        hcfg_set(home, key, after)
        fault(f"mid:{key}")   # edit landed, its result not yet journalled: rollback must work key by key
        produced()
        fault(f"after:{key}")

    try:
        # 1. the one MCP entry (never touches other mcp_servers entries)
        remember(f"mcp_servers.{MCP_NAME}", mcp_entry(url))
        # 2. app + pointer skills as an extra skills dir
        try:
            dirs = list(raw_get(raw_config(home), "skills.external_dirs") or [])
        except KeyError:
            dirs = []
        wanted = [str(osh / "skills"), builder['system_skills']]
        after = dirs + [d for d in wanted if d not in [str(Path(p).expanduser()) for p in dirs]]
        if after != dirs:
            remember("skills.external_dirs", after)
        # 3. the wizard-os plugin (stock `hermes plugins install`, then the allow-list)
        if not (home / "plugins" / PLUGIN_NAME).is_dir():
            args = ["plugins", "install", ns.plugin_source or PLUGIN_SOURCE, "--no-enable", "--no-deps"]
            if ns.plugin_ref:
                args += ["--ref", ns.plugin_ref]
            rec["plugin_installed"] = True   # recorded first: a half-finished install is removed on rollback
            save_record(rec)
            fault("before:plugin")
            local = Path(ns.plugin_source or '').expanduser()
            if local.is_dir():
                # Stock Hermes discovers local plugins in HERMES_HOME/plugins; no core changes.
                if not (local / '__init__.py').is_file():
                    raise Fail('usage', 'local plugin source has no __init__.py')
                (home / 'plugins').mkdir(exist_ok=True)
                shutil.copytree(local, home / 'plugins' / PLUGIN_NAME)
            else:
                run_hermes(home, *args)
            rec['plugin_sha256'] = plugin_fingerprint(home)
            rec['plugin_ref'] = ns.plugin_ref
            save_record(rec)
            produced()
            fault("after:plugin")
        try:
            enabled = list(raw_get(raw_config(home), "plugins.enabled") or [])
        except KeyError:
            enabled = []
        if PLUGIN_NAME not in enabled:
            remember("plugins.enabled", enabled + [PLUGIN_NAME])
        # No 4th edit: stock Hermes has no per-tool eager setting (only `tools.tool_search.defer`) and always keeps
        # MCP tools behind Tool Search, so `wizard_apps` is reached like any app tool. An older link that recorded
        # `tools.tool_search.eager_tools` is still reversed by `unlink`, which replays whatever `edits` holds.
        # secrets into the Hermes .env (0600): the gateway token, and an API key when the API server has none yet
        names = env_names(envp)
        if names.get(TOKEN_ENV) != token:
            rec["env_added"].append(TOKEN_ENV)
            save_record(rec)
            fault("before:env")
            if TOKEN_ENV in names:
                env_remove(envp, [TOKEN_ENV])
            env_append(envp, TOKEN_ENV, token)
            fault("mid:env")
            produced()
            fault("after:env")
        if len(names.get("API_SERVER_KEY", "")) < 16:
            # The same key every time (kept 0600 next to the gateway token): the shell captured it at install, so
            # unlink -> link must not hand Hermes a new one the shell doesn't know (wizard-os#28 relink defect).
            api_key = secret_file(osh / "hermes-api-key")
            rec["env_added"].append("API_SERVER_KEY")
            rec["notes"].append("Hermes had no API key; added API_SERVER_KEY so its API server starts (the shell uses it)")
            save_record(rec)
            fault("before:apikey")
            env_append(envp, "API_SERVER_KEY", api_key)
            fault("mid:apikey")
            produced()
            fault("after:apikey")
        rec["config_sha_after"] = sha256_file(cfgp)
        rec["env_sha_after"] = sha256_file(envp)
        rec.update(linked=True, state="linked")
        save_record(rec)
    except BaseException as e:   # noqa: BLE001 - Ctrl-C included: never leave a half-linked Hermes behind
        try:
            undone = rollback_link(rec)
        except Exception as re_:  # noqa: BLE001
            raise Fail("tool_error", f"link failed ({_why(e)}) and the rollback did not finish ({_why(re_)}); the "
                       f"journal is kept in {os_home() / LINK_FILE}: run `wizard unlink` to finish it",
                       stage="rollback_incomplete") from None
        if isinstance(e, KeyboardInterrupt):
            raise
        raise Fail("tool_error", f"link failed ({_why(e)}); nothing was left changed in {home}",
                   stage="rolled_back", rolled_back=undone) from None
    p = osh / LINK_FILE
    restarted = False
    if ns.restart:
        restarted = run_hermes(home, "gateway", "restart", check=False, timeout=180).returncode == 0
    out = {"ok": True, "hermes_home": str(home), "gateway": url, "record": str(p),
           "edits": [e["key"] for e in rec["edits"]], "env_added": rec["env_added"],
           "plugin_installed": rec["plugin_installed"], "notes": rec["notes"], "gateway_restarted": restarted,
           "next": "" if restarted else "restart Hermes so it loads the plugin and the wizard MCP server: hermes gateway restart"}
    if recovered is not None:
        out["recovered_unfinished_link"] = recovered
    return out


def _why(e: BaseException) -> str:
    return (e.message if isinstance(e, Fail) else f"{type(e).__name__}: {e}")[:300]


def fault(point: str) -> None:
    """Test-only fault injection (tools/tests/test_wizard_link.py): WIZARD_LINK_FAULT=<point>[=kill], e.g.
    `after:plugin=kill`. `kill` exits
    at once with no cleanup, like a killed process; otherwise the step raises. Unset in normal use."""
    want = os.environ.get("WIZARD_LINK_FAULT", "")
    if not want:
        return
    name, _, how = want.partition("=")
    if name != point:
        return
    if how == "kill":
        os._exit(137)
    raise RuntimeError(f"injected fault at {point}")


def remove_installed_plugin(home: Path, rec: dict) -> None:
    """Undo `hermes plugins install` for the plugin link installed: its folder and its install-metadata entry.
    (`hermes plugins remove` would also rewrite config.yaml with Hermes' defaults; the allow-list entry is
    reversed separately, like every other recorded edit.)"""
    import shutil
    pdir = home / "plugins"
    shutil.rmtree(pdir / PLUGIN_NAME, ignore_errors=True)
    meta = pdir / ".install-metadata.json"
    if rec.get("plugin_metadata_existed") and meta.is_file():
        try:
            data = json.loads(meta.read_text(encoding="utf-8"))
            data.pop(PLUGIN_NAME, None)
            meta.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        except (OSError, ValueError):
            pass
    else:
        for f in (meta, pdir / ".install-metadata.json.lock"):
            try:
                f.unlink()
            except OSError:
                pass
    if not rec.get("plugins_dir_existed"):
        try:
            pdir.rmdir()
        except OSError:
            pass


def _semantic(cfg: dict) -> dict:
    return {k: v for k, v in (cfg or {}).items() if k != "_config_version"}


def cmd_unlink(ns) -> dict:
    import shutil
    pending = pending_record()
    if pending:   # a link that never finished: roll its journal back instead
        try:
            undone = rollback_link(pending)
        except Exception as e:  # noqa: BLE001 - same JSON contract as a failed link's rollback
            raise Fail("tool_error", f"the unfinished link could not be rolled back ({_why(e)}); the journal is "
                       f"kept in {os_home() / LINK_FILE}: fix the cause and run `wizard unlink` again",
                       stage="rollback_incomplete") from None
        restarted = False
        if ns.restart:
            restarted = run_hermes(Path(pending["hermes_home"]), "gateway", "restart", check=False,
                                   timeout=180).returncode == 0
        return {"ok": True, "linked": False, "recovered_unfinished_link": True, **undone,
                "gateway_restarted": restarted}
    rec = link_record()
    if not rec:
        return {"ok": True, "linked": False, "message": "not linked; nothing to undo"}
    home = Path(rec["hermes_home"])
    cfgp, envp = home / "config.yaml", home / ".env"
    bdir = Path(rec["backup"])
    untouched_since_link = sha256_file(cfgp) == rec.get("config_sha_after")
    if rec.get("plugin_installed"):
        if not rec.get('plugin_sha256') or plugin_fingerprint(home) != rec['plugin_sha256']:
            rec.setdefault('notes', []).append('Modified or unattested plugin preserved on unlink')
            rec['plugin_installed'] = False
        else:
            remove_installed_plugin(home, rec)
    for e in reversed(rec["edits"]):
        reverse_edit(home, e)
    # Byte-for-byte: when nothing else changed since link (the reversed document means exactly what the backup
    # meant), put the original bytes back, so even whitespace is the owner's.
    backup_cfg = bdir / "config.yaml"
    try:
        import yaml
        same = _semantic(yaml.safe_load(cfgp.read_text(encoding="utf-8")) or {}) == \
            _semantic(yaml.safe_load(backup_cfg.read_text(encoding="utf-8")) or {})
    except Exception:  # noqa: BLE001
        same = untouched_since_link
    if same and sha256_file(backup_cfg) == rec.get("config_sha_before"):
        shutil.copy2(backup_cfg, cfgp)
    env_names_now = env_names(envp)
    # Keep the API key link added before removing it, so the next link hands Hermes the same key the shell already
    # has (covers boxes linked before link reused a saved key).
    added_key = env_names_now.get("API_SERVER_KEY", "")
    keyf = os_home() / "hermes-api-key"
    if "API_SERVER_KEY" in (rec.get("env_added") or []) and len(added_key) >= 16 and not keyf.is_file():
        fd = os.open(keyf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(added_key + "\n")
    env_ok = True
    if rec.get("env_existed") and (bdir / ".env").is_file():
        env_remove(envp, rec.get("env_added") or [])
        if env_names(envp) == env_names(bdir / ".env"):
            shutil.copy2(bdir / ".env", envp)
        else:
            env_ok = False
    elif not rec.get("env_existed"):
        env_remove(envp, rec.get("env_added") or [])
        if envp.is_file() and not envp.read_text(encoding="utf-8").strip():
            envp.unlink()
    del env_names_now
    byte_identical = sha256_file(cfgp) == rec.get("config_sha_before")
    rec["linked"] = False
    rec["unlinked"] = {"config_byte_identical": byte_identical, "env_restored": env_ok,
                       "owner_changed_config_since_link": not untouched_since_link and not same}
    rec["state"] = "unlinked"
    save_record(rec)
    restarted = False
    if ns.restart:
        restarted = run_hermes(home, "gateway", "restart", check=False, timeout=180).returncode == 0
    return {"ok": True, "linked": False, "config_byte_identical": byte_identical, "env_restored": env_ok,
            "reversed": [e["key"] for e in rec["edits"]], "plugin_removed": bool(rec.get("plugin_installed")),
            "env_removed": rec.get("env_added") or [], "gateway_restarted": restarted,
            "note": "" if byte_identical else "the owner edited config.yaml after linking; only Wizard OS keys were reversed"}


def _check(rows: list, name: str, ok: bool, detail: str = "") -> bool:
    rows.append({"check": name, "ok": bool(ok), "detail": detail})
    return bool(ok)


def _http_json(url: str, token: str = "", timeout: float = 5.0):
    h = {"Accept": "application/json"}
    if token:
        h["Authorization"] = f"Bearer {token}"
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(urllib.request.Request(url, headers=h), timeout=timeout) as r:
        return r.status, json.loads(r.read() or b"null")


def cmd_doctor(ns) -> dict:
    rows: list = []
    home = hermes_home_path(ns.hermes_home)
    rec = link_record()
    st = alongside_state()
    _check(rows, "Hermes config present", (home / "config.yaml").is_file(), str(home / "config.yaml"))
    if pending_record():
        _check(rows, "no unfinished link", False, "a link stopped half-way; `wizard unlink` rolls it back")
    _check(rows, "linked (wizard link)", bool(rec), str(os_home() / LINK_FILE))
    cfg = raw_config(home)
    url = (rec or {}).get("gateway") or gateway_url(ns)
    try:
        entry = raw_get(cfg, f"mcp_servers.{MCP_NAME}")
    except KeyError:
        entry = None
    _check(rows, "Hermes has the wizard MCP server", isinstance(entry, dict) and entry.get("url") == url,
           url if entry else "missing")
    try:
        dirs = [str(Path(d).expanduser()) for d in raw_get(cfg, "skills.external_dirs") or []]
    except KeyError:
        dirs = []
    _check(rows, "Hermes reads the Wizard OS skills", str(os_home() / "skills") in dirs, str(os_home() / "skills"))
    try:
        for name, ok, detail in builder_module().health(os_home(), home):
            _check(rows, name, ok, detail)
    except (Fail, ImportError, ValueError) as e:
        _check(rows, 'Wizard builder bundle', False, str(e))
    try:
        enabled = raw_get(cfg, "plugins.enabled") or []
    except KeyError:
        enabled = []
    _check(rows, "wizard-os plugin installed and enabled",
           (home / "plugins" / PLUGIN_NAME / "plugin.yaml").is_file() and PLUGIN_NAME in enabled,
           str(home / "plugins" / PLUGIN_NAME))
    envn = env_names(home / ".env")
    token = envn.get(TOKEN_ENV, "")
    _check(rows, "gateway token in the Hermes .env", bool(token), f"{TOKEN_ENV} (value not shown)")
    origin = ((st.get("agent") or {}).get("origin")) or "http://127.0.0.1:8642"
    try:
        code, _ = _http_json(f"{origin}/health")
        _check(rows, "Hermes API answers", code < 500, origin)
    except Exception as e:  # noqa: BLE001
        _check(rows, "Hermes API answers", False, f"{origin}: {str(e)[:100]}")
    # The shell reads chats over the Hermes API and sees only the agent's images folder. Sharing the whole Hermes
    # home (for state.db) is an owner opt-in (`wam alongside --share-history`): that mount also exposes .env,
    # auth.json and any other credential there.
    if (st.get("shell") or {}).get("share_history"):
        db = home / "state.db"
        uid = (st.get("agent") or {}).get("uid", os.getuid())
        try:
            dst = db.stat()
            readable = dst.st_uid == int(uid) and bool(dst.st_mode & 0o400) and os.access(home, os.X_OK)
            detail = (f"{db} (owner uid {dst.st_uid}, shell uid {uid}, read-only; the shell can read every file in "
                      f"{home}, credentials included)")
        except OSError as e:
            readable, detail = False, f"{db}: {e.strerror}"
        _check(rows, "session history readable", readable, detail)
    else:
        _check(rows, "Hermes home not shared with the shell", True,
               "chats over the Hermes API, only the agent's images folder mounted; agent thread titles, other-surface "
               "activity and the archived list are off (opt in: wam alongside --share-history)")
    base = url.rsplit("/wizard/mcp", 1)[0]
    try:
        code, health = _http_json(f"{base}/wizard/health")
        _check(rows, "Wizard shell answers", code == 200 and isinstance(health, dict), base)
        _check(rows, "shell reaches this Hermes", bool((health or {}).get("upstream_reachable")),
               "upstream_reachable" if (health or {}).get("upstream_reachable") else "shell can't reach Hermes")
    except Exception as e:  # noqa: BLE001
        _check(rows, "Wizard shell answers", False, f"{base}: {str(e)[:100]}")
    # one live request through the bridge: wizard_apps on the gateway, with the token Hermes uses
    live = None
    if token:
        try:
            gw = MCP({"id": "wizard", "mcp": {"url": url}}, "url", 20)
            gw.token = token
            gw.open()
            names = [t.get("name") for t in gw.tools()]
            res = gw.request("tools/call", {"name": "wizard_apps", "arguments": {}})
            gw.close()
            text = "".join(c.get("text", "") for c in res.get("content") or [] if isinstance(c, dict))
            live = {"tools": len(names), "app_tools": [n for n in names if "__" in n][:12]}
            _check(rows, "live request through the bridge (wizard_apps)", not res.get("isError") and bool(text),
                   f"{len(names)} tools on the gateway")
        except Fail as e:
            _check(rows, "live request through the bridge (wizard_apps)", False, e.message[:160])
    else:
        _check(rows, "live request through the bridge (wizard_apps)", False, "no gateway token")
    gate = None
    if ns.gate:
        gate = run_gate_request(home, ns)
        _check(rows, "gate request (Hermes picks the app tool first)", gate.get("pass", False),
               f"{gate.get('prompt')!r} -> {gate.get('first') or 'no app call'}")
    return {"ok": all(r["ok"] for r in rows), "checks": rows, "gateway": url, "live": live, "gate": gate}


def run_gate_request(home: Path, ns) -> dict:
    """One weak-model gate request (spec/AGENT_BRIDGE.md, Proof): a fresh Hermes chat with a job-worded request;
    pass when the first app-relevant tool call is the expected <app>__<tool>. Only tool names are kept."""
    import subprocess
    reg = {}
    try:
        reg = load_registry(registry_path(None))
    except Fail:
        pass
    ids = {a.get("id") for a in reg.get("apps") or []}
    if "hello-wizard" in ids:
        prompt, want = "what time is it on my server?", "hello_wizard__wizard_time"
    else:
        prompt, want = "what apps do I have installed?", "wizard_apps"
    neutral = {"skill_view", "skills_list", "tool_search", "tool_describe", "todo", "todo_list", "memory"}
    cmd = [hermes_bin(), "chat", "-q", prompt, "--format", "stream-json", "--yolo", "--max-turns", "6"]
    if ns.model:
        cmd += ["-m", ns.model]
    if ns.provider:
        cmd += ["--provider", ns.provider]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL,
                             env={**os.environ, "HERMES_HOME": str(home)}).stdout
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
    calls = []
    for line in out.splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if ev.get("type") != "tool_use":
            continue
        name, args = str(ev.get("name") or ""), ev.get("input") if isinstance(ev.get("input"), dict) else {}
        inner = [str(c.get("name") or "") for c in (args.get("calls") or [args])] if name == "tool_call" else [name]
        calls += [n.split(f"mcp__{MCP_NAME}__", 1)[-1] for n in inner]
    first = next((c for c in calls if c and c not in neutral), None)
    return {"prompt": prompt, "expected": want, "first": first, "calls": calls[:8], "pass": first == want}


def human(cmd: str, out: dict) -> str:
    if cmd == "doctor":
        lines = [f"{'PASS' if r['ok'] else 'FAIL'}  {r['check']}  {r['detail']}" for r in out["checks"]]
        if out.get("gate"):
            lines.append(f"gate: first app call {out['gate'].get('first')!r}, expected {out['gate']['expected']!r}")
        return "\n".join(lines)
    if cmd in ("link", "unlink"):
        return json.dumps(out, indent=2)
    if cmd == "apps":
        if not out["apps"]:
            return f"No apps installed ({out['registry']})."
        rows = []
        for a in out["apps"]:
            mark = "mcp" if a["callable"] else ("off" if a.get("mcp") else "view")
            rows.append(f"{a.get('id', '?'):<22} {str(a.get('status') or '-'):<10} {mark:<5} {a.get('summary') or ''}")
        return "\n".join(rows)
    if cmd == "tools":
        if "tool" in out:
            return json.dumps(out["tool"], indent=2)
        lines = []
        for t in out["tools"]:
            req = (t.get("inputSchema") or {}).get("required") or []
            desc = (t.get("description") or "").strip().splitlines()[0:1]
            lines.append(f"{t['name']}({', '.join(req)})  {desc[0][:120] if desc else ''}")
        return "\n".join(lines) or f"{out['app']} lists no tools."
    if out.get("data") is not None and not out.get("text"):
        return json.dumps(out["data"], indent=2)
    return out.get("text") or json.dumps(out["result"], indent=2)


class Parser(argparse.ArgumentParser):
    def error(self, message):  # argparse errors become the deterministic `usage` failure
        raise Fail("usage", f"{message} (try: {self.prog} --help)")


def build_parser() -> Parser:
    # Options are accepted before or after the subcommand. SUPPRESS keeps a subparser from overwriting
    # a value given earlier; defaults are applied in options().
    common = argparse.ArgumentParser(add_help=False)
    S = argparse.SUPPRESS
    common.add_argument("--json", action="store_true", default=S, help="machine-readable output on stdout (errors too)")
    common.add_argument("--registry", metavar="PATH", default=S, help="apps.json to read (default $WIZARD_APPS_JSON, "
                        "else $WIZARD_OS_HOME/apps.json, else ~/.wizard-os/apps.json)")
    common.add_argument("--endpoint", choices=("url", "internal"), default=S,
                        help="registry MCP address to use: url (from the host, default) or internal "
                        "(from a container on the app network); env WIZARD_MCP_ENDPOINT")
    common.add_argument("--timeout", type=float, default=S, help="seconds per HTTP request (default 120; env WIZARD_TIMEOUT)")
    p = Parser(prog="wizard", description="Use any installed Wizard app's MCP tools.", parents=[common])
    p.add_argument("--version", action="version", version=f"wizard {VERSION} ({MARKER})")
    sub = p.add_subparsers(dest="cmd", metavar="{apps,tools,call,link,unlink,doctor}", parser_class=Parser)
    apps = sub.add_parser("apps", help="installed apps", parents=[common])
    apps_sub = apps.add_subparsers(dest="apps_cmd", metavar="{list}", parser_class=Parser)
    apps_sub.add_parser("list", help="list installed apps from the registry", parents=[common])
    t = sub.add_parser("tools", help="list an app's tools, or show one tool's schema", parents=[common])
    t.add_argument("target", metavar="<app>[.<tool>]")
    c = sub.add_parser("call", help="call one tool", parents=[common])
    c.add_argument("target", metavar="<app>.<tool>")
    c.add_argument("args", nargs="?", metavar="ARGS", help="JSON object of tool arguments, '-' to read stdin, "
                   "or @file (default {})")
    for name, hlp in (("link", "connect this box's existing Hermes to the apps (alongside mode)"),
                      ("unlink", "reverse exactly what `wizard link` changed"),
                      ("doctor", "check the link, the shell and the gateway; one live request")):
        x = sub.add_parser(name, help=hlp, parents=[common])
        x.add_argument("--hermes-home", default=None, help="the owner's Hermes home (default $HERMES_HOME or ~/.hermes)")
        if name in ("link", "unlink"):
            x.add_argument("--restart", action="store_true", help="restart the Hermes gateway afterwards")
        if name == "link":
            x.add_argument("--url", default=None, help="gateway URL (default from alongside.json, port 8796)")
            x.add_argument("--plugin-source", default=None, help=f"plugin to install (default {PLUGIN_SOURCE})")
            x.add_argument("--plugin-ref", default=None, help="exact 40-char commit of the plugin source")
        if name == "doctor":
            x.add_argument("--url", default=None)
            x.add_argument("--gate", action="store_true", help="also run one weak-model gate request through Hermes")
            x.add_argument("--model", default=None)
            x.add_argument("--provider", default=None)
    return p


def options(ns) -> argparse.Namespace:
    ns.json = getattr(ns, "json", False)
    ns.registry = getattr(ns, "registry", None)
    ns.endpoint = getattr(ns, "endpoint", None) or os.environ.get("WIZARD_MCP_ENDPOINT") or "url"
    if ns.endpoint not in ("url", "internal"):
        raise Fail("usage", f"--endpoint must be url or internal, not {ns.endpoint}")
    try:
        ns.timeout = float(getattr(ns, "timeout", None) or os.environ.get("WIZARD_TIMEOUT") or 120)
    except ValueError:
        raise Fail("usage", "WIZARD_TIMEOUT must be a number of seconds")
    return ns


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    want_json = "--json" in argv[: argv.index("--")] if "--" in argv else "--json" in argv
    p = build_parser()
    try:
        ns = options(p.parse_args(argv))
        if ns.cmd == "apps" and getattr(ns, "apps_cmd", None) == "list":
            out, kind = cmd_apps_list(ns), "apps"
        elif ns.cmd == "tools":
            out, kind = cmd_tools(ns), "tools"
        elif ns.cmd == "call":
            out, kind = cmd_call(ns), "call"
        elif ns.cmd == "link":
            with link_lock():
                out, kind = cmd_link(ns), "link"
        elif ns.cmd == "unlink":
            with link_lock():
                out, kind = cmd_unlink(ns), "unlink"
        elif ns.cmd == "doctor":
            out, kind = cmd_doctor(ns), "doctor"
            print(json.dumps(out) if want_json else human(kind, out))
            return 0 if out["ok"] else 1
        else:
            raise Fail("usage", "usage: wizard apps list | wizard tools <app>[.<tool>] | wizard call <app>.<tool> [ARGS]"
                       "  (add --json for machine-readable output)")
    except Fail as e:
        if want_json:
            err = {"code": e.code, "message": e.message, "exit": e.exit}
            err.update({k: v for k, v in e.detail.items() if v is not None})
            print(json.dumps({"ok": False, "error": err}))
        else:
            print(f"wizard: {e.message}", file=sys.stderr)
        return e.exit
    except KeyboardInterrupt:
        return 130
    print(json.dumps(out) if want_json else human(kind, out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
